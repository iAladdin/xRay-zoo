{
  "apiVersion": "xray-zoo/v1alpha1",
  "kind": "PlanVersion",
  "planKey": "global-50gb",
  "version": 1,
  "status": "draft",
  "name": "环球轻量 · 50 GB",
  "billing": {
    "currency": "USD",
    "amountMinor": 6000,
    "interval": "month",
    "intervalCount": 1,
    "trialDays": 0,
    "automaticRenewal": true
  },
  "entitlement": {
    "quotaBytes": 50000000000,
    "displayUnit": "GB",
    "bytesPerDisplayUnit": 1000000000,
    "metering": "upload-plus-download",
    "resetPolicy": "paid-service-period",
    "nodePoolRefs": [
      "standard"
    ],
    "strictDeviceLimit": null
  },
  "lifecycle": {
    "cancelPolicy": "end-of-paid-period",
    "failedRenewalGraceSeconds": 0,
    "quotaExhaustionPolicy": "suspend-access",
    "planChangePolicy": "next-paid-period"
  },
  "notes": [
    "默认价按 50 GB × US$0.12/GB 亚洲出网估算成本 × 10；未含固定成本分摊、手续费和税费",
    "完整三档默认套餐见 packages/core/default-plans.ts；当前仍为本地 Stripe Sandbox",
    "多个地区共享一份额度",
    "旧订单与既有续费合约不因默认套餐更新而改变"
  ]
}
