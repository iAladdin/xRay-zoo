generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role String @default("CUSTOMER")
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
  subscription Subscription?
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Plan {
  id String @id
  name String
  amountMinor Int
  currency String
  quotaBytes BigInt
  regions String[]
  active Boolean @default(true)
  globalPool Boolean @default(false)
  orders Order[]
}
model Order {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  planId String
  plan Plan @relation(fields: [planId], references: [id])
  provider String
  status String @default("pending")
  idempotencyKey String
  amountMinor Int
  currency String
  quotaBytes BigInt
  regions String[]
  globalPool Boolean @default(false)
  checkoutId String? @unique
  checkoutUrl String?
  providerSubscriptionId String?
  createdAt DateTime @default(now())
  periods ServicePeriod[]
  @@unique([userId, idempotencyKey])
}
model ProviderEvent {
  id String @id @default(uuid())
  provider String
  eventId String
  kind String
  payload Json
  status String @default("pending")
  lastError String?
  createdAt DateTime @default(now())
  @@unique([provider, eventId])
}
model Subscription {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  status String @default("pending")
  desiredVersion Int @default(0)
  appliedVersion Int @default(0)
  engineUserId String? @unique
  accessUuidCipher String?
  revokedAt DateTime?
  tokenHash String? @unique
  tokenCipher String?
  validUntil DateTime?
  quotaBytes BigInt @default(0)
  usedBytes BigInt @default(0)
  meterBaseline BigInt @default(0)
  regions String[]
  globalPool Boolean @default(false)
  lastUsageAt DateTime?
  lastError String?
  currentPeriodId String?
  syncLeaseOwner String?
  syncLeaseUntil DateTime?
  createdAt DateTime @default(now())
  periods ServicePeriod[]
}
model ServicePeriod {
  id String @id @default(uuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  provider String
  invoiceId String
  startAt DateTime
  endAt DateTime
  quotaBytes BigInt
  status String @default("paid")
  createdAt DateTime @default(now())
  @@unique([provider, invoiceId])
}
model Outbox {
  id String @id @default(uuid())
  kind String
  aggregateId String
  version Int
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@unique([kind, aggregateId, version])
  @@index([deliveredAt])
}
model Node {
  id String @id
  name String @unique
  region String
  country String
  address String
  port Int @default(443)
  publicKey String
  shortId String
  serverName String
  engineNodeId String?
  configProfileId String?
  inboundId String?
  squadId String?
  ready Boolean @default(false)
  checkedAt DateTime?
  enabled Boolean @default(true)
  engineConnected Boolean @default(false)
  engineDisabled Boolean @default(false)
  transportConnected Boolean?
  healthReason String @default("UNKNOWN")
  lastHealthyAt DateTime?
  usageBytes BigInt @default(0)
  usageUpdatedAt DateTime?
  xrayVersion String?
  controlLeaseOwner String?
  controlLeaseUntil DateTime?
  globalPool Boolean @default(false)
  publishedAt DateTime? @default(now())
  azureVmId String?
  vmSize String?
  controlPort Int? @unique
  operationId String? @unique
  resourceState String @default("active")
  activeLifecycleId String?
  releasedAt DateTime?
  deploymentConfig Json?
  realityStateCipher String?
  diskType String @default("StandardSSD_LRS")
  diskSizeGiB Int @default(32)
  lifecycles NodeLifecycle[]
  activeIpRotationId String?
  addressChanging Boolean @default(false)
  ipRotations IpRotation[]
}
model ProvisionPlan {
  id String @id @default(uuid())
  actorId String
  snapshot Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  operation ProvisionOperation?
  kind String @default("machine")
  ipRotation IpRotation?
}
model IpRotation {
  id String @id @default(uuid())
  nodeId String
  node Node @relation(fields:[nodeId],references:[id])
  planId String @unique
  plan ProvisionPlan @relation(fields:[planId],references:[id])
  actorId String
  idempotencyKey String
  oldAddress String
  newAddress String?
  phase String @default("queued")
  status String @default("running")
  checkpoint Json @default("{}")
  events Json @default("[]")
  errorCode String?
  leaseOwner String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phaseStartedAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([actorId,idempotencyKey])
  @@index([status,leaseUntil])
  @@index([nodeId,createdAt])
}
model ProvisionOperation {
  id String @id @default(uuid())
  planId String @unique
  plan ProvisionPlan @relation(fields:[planId],references:[id])
  actorId String
  idempotencyKey String
  nodeName String
  region String
  country String
  size String
  controlPort Int
  phase String @default("queued")
  status String @default("running")
  azureState String?
  checkpoint Json @default("{}")
  privateState String?
  errorCode String?
  attempts Int @default(1)
  leaseOwner String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phaseStartedAt DateTime @default(now())
  finishedAt DateTime?
  events ProvisionEvent[]
  @@unique([actorId,idempotencyKey])
  @@index([status,leaseUntil])
}
model ProvisionEvent {
  id String @id @default(uuid())
  operationId String
  operation ProvisionOperation @relation(fields:[operationId],references:[id])
  phase String
  message String
  createdAt DateTime @default(now())
  @@index([operationId,createdAt])
}
model NodeMaintenanceBatch {
  id String @id @default(uuid())
  actorId String
  idempotencyKey String
  requestHash String
  action String
  items Json
  status String @default("running")
  leaseOwner String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finishedAt DateTime?
  @@unique([actorId,idempotencyKey])
  @@index([status,leaseUntil])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String
  detail Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model NodeLifecycle {
  id String @id @default(uuid())
  nodeId String
  node Node @relation(fields: [nodeId], references: [id])
  actorId String
  idempotencyKey String
  action String
  phase String @default("queued")
  status String @default("running")
  checkpoint Json @default("{}")
  machineId String? @unique
  events Json @default("[]")
  errorCode String?
  leaseOwner String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phaseStartedAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([actorId, idempotencyKey])
  @@index([status, leaseUntil])
  @@index([nodeId, createdAt])
}
