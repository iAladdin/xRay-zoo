# Design-stage example. No application currently consumes this file.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
SUBSCRIPTION_ORIGIN=https://sub.example.invalid
DATABASE_URL=
REDIS_URL=

# Standard OIDC; choose and pin a provider before implementation.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# SecretStore master key is never committed; use Key Vault in deployment.
SECRET_STORE_BACKEND=azure-key-vault
AZURE_KEY_VAULT_URL=
LOCAL_SECRET_STORE_MASTER_KEY=

# Bootstrap development only. Product cloud connections live in SecretStore.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_PASSWORD=
AZURE_RESOURCE_GROUP=xray-zoo-dev

# Internal only, no browser exposure.
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=

# Test credentials until an actual merchant account is configured.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
