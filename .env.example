# Reference only. scripts/local-env.py creates .local/app.env used by this build.
APP_ENV=local
APP_ORIGIN=http://localhost:3100
API_ORIGIN=http://localhost:3101
SUBSCRIPTION_ORIGIN=http://localhost:3101
DATABASE_URL=
REDIS_URL=
ENCRYPTION_KEY=

# Planned OIDC configuration; not consumed by the local password provider yet.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# Planned production SecretStore; local P0 uses ENCRYPTION_KEY above.
SECRET_STORE_BACKEND=azure-key-vault
AZURE_KEY_VAULT_URL=
LOCAL_SECRET_STORE_MASTER_KEY=

# Bootstrap development only. Product cloud connections live in SecretStore.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_PASSWORD=
AZURE_RESOURCE_GROUP=xray-zoo-dev

# Internal only, no browser exposure.
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=

# Test credentials until an actual merchant account is configured.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
